{
  "name": "evolving-mcp",
  "version": "0.1.0",
  "description": "An MCP server that writes its own tools from how it gets used",
  "license": "MIT",
  "author": "Anshul Yadav <anshulky@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anshulforyou/evolving-mcp.git"
  },
  "homepage": "https://github.com/anshulforyou/evolving-mcp#readme",
  "bugs": {
    "url": "https://github.com/anshulforyou/evolving-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "llm",
    "agents",
    "tools",
    "token-efficiency"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "seed": "tsx src/corpus/seed.ts",
    "record": "tsx src/corpus/record.ts",
    "detect": "tsx src/cli/detect.ts",
    "report": "tsx src/cli/report.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "verify": "tsx src/cli/verify.ts",
    "record:llm": "tsx src/corpus/record-llm.ts",
    "seed:fs": "tsx src/corpus/seed-fs.ts",
    "record:fs": "tsx src/corpus/record-fs.ts",
    "compare": "tsx src/cli/compare.ts",
    "footprint": "tsx src/cli/footprint.ts",
    "init": "tsx src/cli/main.ts init",
    "trace": "tsx src/cli/main.ts trace",
    "promote": "tsx src/cli/main.ts promote",
    "serve": "tsx src/cli/main.ts serve",
    "holdout": "tsx src/cli/holdout.ts"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "gpt-tokenizer": "^4.0.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "bin": {
    "evolving-mcp": "./bin/evolving-mcp.js"
  },
  "files": [
    "bin",
    "src",
    "docs",
    "README.md",
    "LICENSE"
  ]
}
